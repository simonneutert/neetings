{
  "name": "neetings",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix",
    "build:secure": "npm run audit && npm run lint && npm run typecheck && npm run test && npm run build",
    "pre-release:secure": "npm run audit && just pre-release"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "docx": "^9.15.2",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/ui": "^5.1.0",
    "baseline-browser-mapping": "^2.11.35",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
